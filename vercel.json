{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true,
      "optimize-neon-compute-20260920": true
    }
  },
  "images": {
    "sizes": [480, 1080, 1440],
    "remotePatterns": [
      {
        "protocol": "https",
        "hostname": "^cdn\\.mrwallpaper\\.org$",
        "port": "",
        "pathname": "^/.*$",
        "search": ""
      }
    ],
    "minimumCacheTTL": 86400,
    "qualities": [75, 85],
    "formats": ["image/webp"]
  }
}